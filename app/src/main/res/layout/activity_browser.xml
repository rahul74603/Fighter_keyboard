<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/btnBack"
            style="@style/AppButtonGhost"
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/br_back"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnForward"
            style="@style/AppButtonGhost"
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/br_forward"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnReload"
            style="@style/AppButtonGhost"
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/br_reload"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnHome"
            style="@style/AppButtonGhost"
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/br_home"
            android:textSize="11sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/practice_bg"
        android:hint="@string/br_address_hint"
        android:imeOptions="actionGo"
        android:inputType="textUri"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:selectAllOnFocus="true"
        android:textColor="@color/app_text"
        android:textColorHint="@color/app_text_dim"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvBrowserHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#E6101319"
            android:padding="10dp"
            android:text="@string/br_hint"
            android:textColor="@color/kb_text"
            android:textSize="11sp" />
    </FrameLayout>
</LinearLayout>
