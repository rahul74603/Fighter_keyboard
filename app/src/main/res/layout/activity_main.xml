<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="18dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_title"
        android:textColor="@color/app_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/app_subtitle"
        android:textColor="@color/app_text_dim"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvKeyboardStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/status_bg"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:text="@string/status_checking"
        android:textColor="@color/app_text"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnEnable"
            style="@style/AppButtonPrimary"
            android:text="@string/btn_enable" />

        <TextView
            android:id="@+id/btnPick"
            style="@style/AppButtonSecondary"
            android:layout_marginStart="8dp"
            android:text="@string/btn_pick" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNotesTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notes_title"
            android:textColor="@color/app_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAddNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/app_btn_primary"
            android:clickable="true"
            android:focusable="false"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:text="@string/add_note"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvNotes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/notes_empty"
        android:textColor="@color/app_text_dim"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnExport"
            style="@style/AppButtonGhost"
            android:text="@string/export_notes" />

        <TextView
            android:id="@+id/btnImport"
            style="@style/AppButtonGhost"
            android:text="@string/import_notes" />

        <TextView
            android:id="@+id/btnDeleteAll"
            style="@style/AppButtonGhost"
            android:text="@string/delete_all" />
    </LinearLayout>

    <EditText
        android:id="@+id/etPractice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/practice_bg"
        android:gravity="top|start"
        android:hint="@string/practice_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="2"
        android:maxLines="3"
        android:padding="10dp"
        android:textColor="@color/app_text"
        android:textColorHint="@color/app_text_dim"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/how_to_tip"
        android:textColor="@color/app_text_dim"
        android:textSize="11sp" />
</LinearLayout>
