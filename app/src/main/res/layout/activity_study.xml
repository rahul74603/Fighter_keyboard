<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/study_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStudyProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:textColor="@color/kb_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnStudyClose"
            style="@style/StudyChip"
            android:text="@string/close" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnStudyHide"
            style="@style/StudyChip"
            android:text="@string/study_hide" />

        <TextView
            android:id="@+id/btnStudyAuto"
            style="@style/StudyChip"
            android:text="@string/study_auto_next" />

        <TextView
            android:id="@+id/btnStudyShuffle"
            style="@style/StudyChip"
            android:text="@string/tb_shuffle" />

        <TextView
            android:id="@+id/btnStudyScreen"
            style="@style/StudyChip"
            android:text="@string/study_screen_on" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/study_card"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvStudyNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/kb_text"
                android:textSize="21sp" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/revealOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/study_card_solid"
            android:clickable="true"
            android:focusable="false"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/study_hidden_title"
                android:textColor="@color/kb_accent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/study_hidden_hint"
                android:textColor="@color/kb_text_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvStudyStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:textColor="@color/kb_text_dim"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/speed_label"
            android:textColor="@color/kb_text_dim"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/seekStudySpeed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100" />

        <TextView
            android:id="@+id/tvStudySpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:includeFontPadding="false"
            android:minWidth="64dp"
            android:textColor="@color/kb_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnStudyPrev"
            style="@style/StudyControl"
            android:text="@string/study_prev" />

        <TextView
            android:id="@+id/btnStudyPlay"
            style="@style/StudyControlPrimary"
            android:layout_weight="1.6"
            android:text="@string/tb_play" />

        <TextView
            android:id="@+id/btnStudyRepeat"
            style="@style/StudyControl"
            android:text="@string/study_repeat" />

        <TextView
            android:id="@+id/btnStudyNext"
            style="@style/StudyControl"
            android:text="@string/study_next" />
    </LinearLayout>
</LinearLayout>
