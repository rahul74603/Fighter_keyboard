<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/log_title"
            android:textColor="@color/app_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnBackLog"
            style="@style/AppButtonGhost"
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:text="@string/close" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvFacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/app_text_dim"
        android:textSize="11sp" />

    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/practice_bg"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/app_text"
            android:textSize="10sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRefresh"
            style="@style/AppButtonGhost"
            android:text="@string/log_refresh" />

        <TextView
            android:id="@+id/btnCopy"
            style="@style/AppButtonPrimary"
            android:layout_weight="1.3"
            android:layout_marginStart="4dp"
            android:text="@string/log_copy" />

        <TextView
            android:id="@+id/btnClear"
            style="@style/AppButtonGhost"
            android:text="@string/log_clear" />
    </LinearLayout>
</LinearLayout>
