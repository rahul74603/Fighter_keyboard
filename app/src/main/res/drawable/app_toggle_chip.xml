<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/app_accent_soft" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/app_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E4EAF6" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/app_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_surface" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/app_stroke" />
        </shape>
    </item>
</selector>
