<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="KeyView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:background">@drawable/key_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/kb_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">false</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="KeyFunc" parent="KeyView">
        <item name="android:background">@drawable/key_bg_func</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/kb_text_dim</item>
    </style>

    <style name="KeyShift" parent="KeyFunc">
        <item name="android:background">@drawable/key_bg_toggle</item>
        <item name="android:textColor">@color/tool_text</item>
    </style>

    <style name="ToolButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:background">@drawable/tool_button_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/tool_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">false</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="ToolButtonWide" parent="ToolButton">
        <item name="android:layout_weight">2</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="PanelButton" parent="ToolButton">
        <item name="android:layout_height">match_parent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/kb_accent</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="NoteAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/app_accent_dark</item>
        <item name="android:background">@drawable/action_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">false</item>
    </style>

    <style name="NoteActionDark" parent="NoteAction">
        <item name="android:textColor">@color/kb_accent</item>
        <item name="android:background">@drawable/action_chip_dark</item>
    </style>

    <style name="AppButtonPrimary">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/app_btn_primary</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">false</item>
    </style>

    <style name="AppButtonSecondary" parent="AppButtonPrimary">
        <item name="android:background">@drawable/app_btn_secondary</item>
        <item name="android:textColor">@color/app_accent_dark</item>
    </style>

    <style name="BrowserChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:background">@drawable/app_toggle_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">false</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/app_toggle_text</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="StudyChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/study_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/tool_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">false</item>
    </style>

    <style name="StudyControl">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/study_control_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/kb_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">false</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="StudyControlPrimary" parent="StudyControl">
        <item name="android:background">@drawable/study_control_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppToggle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/app_toggle_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/app_toggle_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">false</item>
    </style>

    <style name="AppButtonGhost">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:background">@drawable/app_btn_ghost</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">false</item>
    </style>
</resources>
